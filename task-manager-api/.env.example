# Copie para o ambiente (o projeto não carrega .env automaticamente). Valores fictícios.
# Obrigatória, persistente e com no mínimo 32 caracteres. Sem ela a aplicação e o seed não iniciam.
SECRET_KEY=troque-por-um-valor-aleatorio-com-32-ou-mais-caracteres
# Opcionais (padrões entre parênteses)
DATABASE_URL=sqlite:///tasks.db
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=*
TOKEN_MAX_AGE=3600
# Obrigatórias apenas para python seed.py (mínimo de 4 caracteres cada)
SEED_ADMIN_PASSWORD=troque-esta-senha
SEED_USER_PASSWORD=troque-esta-senha
SEED_MANAGER_PASSWORD=troque-esta-senha
