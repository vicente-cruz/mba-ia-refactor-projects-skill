# Copie para o seu ambiente (export VAR=valor). Valores abaixo são fictícios.
SECRET_KEY=troque-por-um-valor-aleatorio
DATABASE_PATH=loja.db
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
# Token exigido em X-Admin-Token por /admin/*, /relatorios/vendas e GET /usuarios.
# Sem ele, esses endpoints respondem 403.
ADMIN_TOKEN=troque-por-um-token-aleatorio
# Senhas dos usuários de demonstração criados no seed (usuário não é criado se a variável faltar).
SEED_SENHA_ADMIN=troque-esta-senha
SEED_SENHA_JOAO=troque-esta-senha
SEED_SENHA_MARIA=troque-esta-senha
