# Copie para o ambiente (export ...) antes de `npm start`. Valores abaixo são fictícios.
# Porta HTTP (padrão: 3000)
PORT=3000
# Obrigatória: senha do usuário inicial do seed. Sem ela, a aplicação não inicia.
SEED_USER_PASSWORD=troque-por-uma-senha-forte
# Token exigido no cabeçalho X-Admin-Token por GET /api/admin/financial-report e DELETE /api/users/:id.
# Sem ele, esses endpoints respondem 403. Use um valor longo e aleatório.
ADMIN_TOKEN=troque-por-um-token-aleatorio
